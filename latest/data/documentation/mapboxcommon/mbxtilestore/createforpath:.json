sion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The returned instance exists as long as it is retained by the client."},{"text":" ","type":"text"},{"text":"If the tile store instance already exists for the given path this method will return it without creating","type":"text"},{"text":" ","type":"text"},{"text":"a new instance, thus making sure that there is only one tile store instance for a path at a time.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the given path is empty, the tile store at the default location is returned."},{"type":"text","text":" "},{"type":"text","text":"On iOS, this storage path is excluded from automatic cloud backup."},{"text":" ","type":"text"},{"text":"On Android, please exclude the storage path in your Manifest.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Please refer to the "},{"identifier":"https:\/\/developer.android.com\/guide\/topics\/data\/autobackup.html#IncludingFiles","type":"reference","isActive":true},{"text":" for detailed information.","type":"text"}]}]}],"sections":[],"references":{"https://developer.android.com/guide/topics/data/autobackup.html#IncludingFiles":{"url":"https:\/\/developer.android.com\/guide\/topics\/data\/autobackup.html#IncludingFiles","type":"link","titleInlineContent":[{"type":"text","text":"Android Documentation"}],"identifier":"https:\/\/developer.android.com\/guide\/topics\/data\/autobackup.html#IncludingFiles","title":"Android Documentation"},"doc://com.mapbox.MapboxMaps/documentation/MapboxCommon":{"role":"collection","abstract":[],"url":"\/documentation\/mapboxcommon","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxCommon","title":"MapboxCommon","kind":"symbol","type":"topic"},"doc://com.mapbox.MapboxMaps/documentation/MapboxCommon/MBXTileStore/createForPath:":{"type":"topic","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxCommon\/MBXTileStore\/createForPath:","tit