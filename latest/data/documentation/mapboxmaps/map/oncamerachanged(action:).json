pbox.MapboxMaps\/documentation\/MapboxMaps\/Map","text":"Map","preciseIdentifier":"s:10MapboxMaps3MapV"}],"platforms":["iOS"]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"content":[{"type":"paragraph","inlineContent":[{"text":"This callback is called on every rendering frame. Don’t use it to modify ","type":"text"},{"type":"codeVoice","code":"@State"},{"type":"text","text":" variables, it will lead to excessive "},{"type":"codeVoice","code":"body"},{"type":"text","text":" execution and higher CPU consumption."}]}],"type":"aside","style":"important","name":"Important"},{"inlineContent":[{"text":"For example:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct BadExample: View {","    @State var zoom: Double = 0","    var body: some View {","        Map {","            if zoom > 5 {","                CircleAnnotation(centerCoordinate: coordinate)","            }","        }","        .onCameraChanged {","            \/\/ DON'T DO THIS","            zoom = $0.cameraState.zoom","        }","    }","}"]},{"inlineContent":[{"text":"Instead update the state only when the actual value is changed:","type":"text"}],"type":"paragraph"},{"code":["struct GoodExample: View {","    private class Model: ObservableObject {","        @Published var showAnnotation = false","        func setZoom(_ zoom: Double) {","            var showAnnotation = zoom < 5","            if showAnnotation != self.showAnnotation {","                \/\/ OK, the showAnnotation updates only when actual value changed.","                \/\/ The `body` will be executed once per update.","                self.showAnnotation = showAnnotation","            }","        }","    }","","    @StateObject var model = Model()","    var body: some View {","        Map {","            if model.showAnnotation {","                CircleAnnotation(centerCoordinate: coordinate)","            }","        }","        .onCameraChanged {","      