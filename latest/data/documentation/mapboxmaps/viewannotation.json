{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ViewAnnotation"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use view annotations if you need to display interactive UIView bound to"},{"text":" ","type":"text"},{"text":"a geographical coordinate or map feature.","type":"text"}]},{"inlineContent":[{"text":"The view annotations are great for displaying unique interactive features. However, they may be suboptimal for large amounts of data and don’t support clustering. For those cases use ","type":"text"},{"identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/PointAnnotation","isActive":true,"type":"reference"},{"type":"text","text":" or Runtime Styling API, for example, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/SymbolLayer"},{"text":" with ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/GeoJSONSource","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"View Annotations appear above all content of MapView (e.g. layers, annotations, puck). If you need to display annotation between layers or below puck, use ","type":"text"},{"identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/PointAnnotation","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To display a view annotation configure a UIView, create "},{"code":"ViewAnnotation","type":"codeVoice"},{"text":", and add it to the view annotation manager:","type":"text"}]},{"syntax":"swift","code":["let view = CustomView()","view.icon = UIImage(named: \"traffic-icon\")","let annotation = ViewAnnotation(","  coordinate: CLLocationCoordinate(latitude: 10, longitude: 10),","  view: view)","mapView.viewAnnotations.add(annotation)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The annotation can be displayed on a layer feature referenced by it’s "},{"code":"layerId","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"featureId"},{"type":"text","text":":"}]},{"syntax":"swift","code":["annotation.annotatedFeature = .layerFeature(layerId: \"route-line\", featureId: \"sf-la\")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view annotation automatically inserts and removes it’s view into the view hierarchy and updates its "},{"type":"codeVoice","code":"isHidden"},{"type":"text","text":" property."}]},{"name":"Important","style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Don’t set "},{"type":"codeVoice","code":"UIView.isHidden"},{"type":"text","text":" property to hide the annotation. Instead, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/ViewAnnotation\/visible"},{"text":" property.","type":"text"}]}]},{"inlineContent":[{"text":"When view content or layout is updated, use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/ViewAnnotation\/setNeedsUpdateSize()"},{"type":"text","text":" to update the the annotation size. It’s safe to use it multiple times, only one update will be performed."}],"type":"paragraph"},{"code":["view.hintText = \"Less Traffic\"","annotation.setNeedsUpdateSize() \/\/ Updates the annotation size."],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"typ